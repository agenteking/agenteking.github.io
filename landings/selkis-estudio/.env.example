# Puerto donde Express sirve API + front (modo Node: dev local / server propio)
PORT=4310
# Postgres (Supabase). Pooler en modo SESIÓN (puerto 5432) para migraciones, seed, tests y dev local.
# Un schema por cliente: ?schema=selkis. El host exacto: GET /v1/projects/<ref>/config/database/pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password-url-encoded>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?schema=selkis"
# npm test: schema APARTE que se borra y se recrea en cada corrida (tiene que terminar en _test).
TEST_DATABASE_URL="postgresql://postgres.<ref>:<password-url-encoded>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?schema=selkis_test"
# Clave del panel /admin (header x-admin-key). Cambiala por una propia (openssl rand -base64 24).
# En la Edge Function va como secret de Supabase (README → "Deploy en Supabase").
ADMIN_KEY=cambiame
# Origen público del sitio, sin barra final: canonical, og:url y JSON-LD (el SSR lo lee en cada render).
SITE_URL=http://localhost:4310
# Proxy delante de Express (define de dónde sale la IP de los frenos). Vacío = ninguno (default: se usa la IP
# del socket y X-Forwarded-For se ignora). Con cloudflared/Caddy/nginx en la misma máquina: loopback.
# Con N proxies en otras máquinas: N (saltos) o sus IPs/CIDR separadas por coma. Nunca "true" si el puerto
# es alcanzable sin pasar por el proxy: cualquiera falsifica la IP y saltea los frenos.
# (En la Edge Function el default es true: ver server/src/edge.ts.)
TRUST_PROXY=
