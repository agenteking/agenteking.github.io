{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "..",
    "outDir": "../dist/server",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../**/*.test.ts"]
}
