// Selkis Estudio — demo de turnos online
// Prisma 7: cliente generado en TS + driver adapter (better-sqlite3).

generator client {
  provider            = "prisma-client"
  output              = "../server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Service {
  id            String         @id
  name          String
  category      String
  description   String
  durationMin   Int
  priceFrom     Int
  sortOrder     Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  professionals Professional[]
  bookings      Booking[]
}

model Professional {
  id        String    @id
  name      String
  specialty String    @default("")
  /// Inactiva: no aparece en el sitio ni recibe turnos online (sus turnos quedan).
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  services  Service[]
  bookings  Booking[]
}

/// Horario del local por día de la semana (0 = domingo … 6 = sábado), "HH:MM" en hora de Buenos Aires.
model BusinessHour {
  weekday Int    @id
  open    String
  close   String
}

model Booking {
  id             String       @id @default(cuid())
  code           String       @unique
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  start          DateTime
  end            DateTime
  customerName   String
  customerPhone  String
  customerEmail  String
  status         String       @default("confirmed") // confirmed | cancelled
  /// online (la clienta desde el sitio) | admin (carga manual desde el panel)
  source         String       @default("online")
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  cancelledAt    DateTime?
  events         BookingEvent[]

  @@index([professionalId, start])
  @@index([start])
}

/// Historial de cada turno (alta, cambios, cancelación), para el panel.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// created | updated | rescheduled | cancelled | reactivated
  action    String
  /// customer | admin
  actor     String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}
