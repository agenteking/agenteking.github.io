# Puerto donde Express sirve API + front
PORT=4320
# SQLite (Prisma + adapter better-sqlite3). Ruta relativa a la raíz del proyecto.
DATABASE_URL="file:./data/agencia.db"
# Clave para listar consultas: GET /api/contacts con header x-admin-key
ADMIN_KEY=cambiame-en-produccion
# Runtime: 1 = noindex (X-Robots-Tag + robots.txt Disallow). Poné 0 al publicar con dominio propio.
NOINDEX=1

# --- Front (se leen en el BUILD; después de cambiarlos, npm run build) ---
# Nombre de la marca: se usa en todo el sitio, títulos, OG y schema.org
VITE_BRAND_NAME=Aparece
# URL canónica (sin barra final) y contacto
VITE_SITE_URL=https://aparece.com.ar
VITE_CONTACT_EMAIL=hola@aparece.com.ar
# WhatsApp en formato internacional sin + ni espacios (ej. 5491100000000). Vacío = se oculta el botón.
VITE_WHATSAPP=5491100000000
# 1 = <meta name="robots" content="noindex"> en el HTML. 0 al publicar.
VITE_NOINDEX=1
# 1 = muestra precios "desde" (orientativos) en los paquetes. 0 = paquetes sin precio + CTA a consulta.
VITE_SHOW_PRICES=0
# Link opcional a la demo navegable (vacío = no se muestra)
VITE_DEMO_URL=
