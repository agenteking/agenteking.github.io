# Back office de leads. Copiá este archivo a un .env FUERA del repo (ej. $AGENT_DIR/data/backoffice/.env, chmod 600)
# y arrancá con scripts/start.sh (lo carga vía DOTENV_CONFIG_PATH).
PORT=4460
# Base SQLite de leads: la MISMA que usa la CLI leads.py (la dueña del esquema).
LEADS_DB=/ruta/absoluta/a/data/leads/leads.db
# Contraseña compartida (Kanel y Gonzalo). Larga y aleatoria: openssl rand -base64 24
BACKOFFICE_PASSWORD=cambiame-por-una-larga-y-aleatoria
# Opcional: clave para firmar la cookie de sesión. Si falta, se deriva de la contraseña
# (cambiar la contraseña cierra todas las sesiones).
# SESSION_SECRET=
